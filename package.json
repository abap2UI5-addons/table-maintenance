{
  "name": "table-maintenance",
  "private": true,
  "version": "1.0.0",
  "description": "Table maintenance in the browser - edit data and customizing entries with value help, fixed values and transport handling.",
  "scripts": {
    "syfixes": "find . -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} + ",
    "downport": "abaplint --fix .github/abaplint/abap_702.jsonc && npm run syfixes",
    "rename": "abaplint .github/abaplint/rename.json --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check": "npm run lint && npm run check:cloud && npm run check:abap2ui5 && npm run rename",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/table-maintenance.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/table-maintenance/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/table-maintenance#readme",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.3",
    "@abap2ui5/linter-render": "^0.8.3",
    "@abaplint/cli": "^2.120.71",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "^2.13.93",
    "@abaplint/transpiler-cli": "^2.13.93",
    "@types/node": "^26.6.3"
  },
  "dependencies": {
    "npm-check-updates": "^23.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
