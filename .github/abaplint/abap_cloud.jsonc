{
    "global": {
      "files": "/../../src/**/*.*"
    },
    "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/layout-management",
      // branch DEV of this repository runs on the DEV branches of abap2UI5 and the addons
      "branch": "DEV",
      "folder": "/abap2UI5-layout",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "DEV",
      "folder": "/abap2UI5",
      "files": "/src/0[0-2]/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/popups",
      "branch": "DEV",
      "folder": "/popups",
      "files": "/src/**/*.*"
    }
    ],
    "syntax": {
      "version": "Cloud",
      "errorNamespace": "."
    },
    "rules": {
      "downport": true,
      "begin_end_names": true,
      "check_ddic": true,
      "check_include": true,
      "check_syntax": true,
      "global_class": true,
      "definitions_top": false,
      "implement_methods": true,
      "method_implemented_twice": true,
      "parser_error": true,
      "superclass_final": true,
      "unknown_types": true,
      "xml_consistency": true
    }
  }
  
