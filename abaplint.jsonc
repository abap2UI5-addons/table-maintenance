{
    "global": {
      "files": "/src/**/*.*"
    },
    "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/layout-management",
      // the main branches of abap2UI5 and the addons (1.151.0) - their release tags once cut
      "branch": "main",
      "folder": "/abap2UI5-layout",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "main",
      "folder": "/abap2UI5",
      "files": "/src/0[0-2]/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/popups",
      "branch": "main",
      "folder": "/popups",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    // off as in abap2UI5's abaplint.jsonc: declarations stay next to their
    // use; the 702 config switches it on, the downport moves them there
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true,
    // the rest of abap2UI5's rule set (abaplint.jsonc of abap2UI5/abap2UI5), with its settings
    "7bit_ascii": true,
    "add_test_attributes": true,
    "aff_and_xml": true,
    "allowed_object_naming": true,
    "ambiguous_statement": true,
    "avoid_use": {
      "skipQuickFix": false,
      "define": true,
      "statics": true,
      "defaultKey": true,
      "break": true,
      "testSeams": true,
      "describeLines": true,
      "exportToMemory": true,
      "exportToDatabase": true,
      // the vendored abap-util copies stay close to the master (AGENTS.md)
      "exclude": ["z2ui5_cl_tm_context", "z2ui5_cx_tm_error"]
    },
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "check_abstract": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    "clear_exporting_parameters": true,
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loopAllowIfSubrc": true,
      "at": true,
      "case": true,
      "catch": true,
      "do": true,
      "exclude": [],
      "if": true,
      "loop": false,
      "select": true,
      "try": true,
      "when": false,
      "while": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "exporting": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "message_exists": true,
    "method_overwrites_builtin": true,
    "mix_returning": true,
    "msag_consistency": true,
    "names_no_dash": true,
    "newline_between_methods": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_parameter_name": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_is_not": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    "prefer_returning_to_exporting": true,
    "prefer_xsdbool": true,
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "prefix_is_current_class": {
      "omitMeInstanceCalls": true,
      "exclude": [],
      "severity": "Warning"
    },
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_performance": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "lines": 4,
      "exclude": [],
      "severity": "Warning"
    },
    "sicf_consistency": true,
    "slow_parameter_passing": {
      // the vendored abap-util copies stay close to the master (AGENTS.md)
      "exclude": ["z2ui5_cl_tm_context", "z2ui5_cx_tm_error"]
    },
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "strict_sql": true,
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    "unused_types": true,
    "use_class_based_exceptions": true,
    "use_line_exists": true,
    "use_message_class": true,
    "use_new": true,
    "when_others_last": true,
    "whitespace_end": true,
    "wrong_abapdoc_position": true,
    "xml_bom": true,
    // added 2026-11: the rules of abap2UI5's abaplint.jsonc this repository
    // passes without a finding, with its settings, and allowed_object_types
    // with the object types this repository ships
    "abapdoc_html_tag": true,
    "abapdoc_leading_at": true,
    "abapdoc_parameter_names": true,
    "abapdoc_shorttext_length": true,
    "allowed_object_types": {
      "allowed": [
        "CLAS",
        "DEVC",
        "INTF"
      ]
    },
    "bound_check_after_create": true,
    "cds_comment_style": true,
    "cds_legacy_view": true,
    "changing_sorted_line": true,
    "clear_after_declaration": true,
    "clear_before_overwrite": true,
    "constant_condition": true,
    "copy_of_initial_variable": true,
    "delete_index_in_loop": true,
    "final_newline": true,
    // an allow list matching no object: the default, empty, allows every one
    "forbidden_kernel_write": {
      "allow": [
        "^$"
      ]
    },
    "inline_packed_computation": true,
    "no_mandt_in_database_operations": true,
    "object_naming": {
      "sxci": "^Z",
      "enhs": "^Z",
      "enho": "^Z",
      "cmod": "^Z",
      "form": "^Z",
      "sfpf": "^Z",
      "sfpi": "^Z",
      "aqqu": "^Z",
      "aqsg": "^Z",
      "aqbg": "^Z",
      "suso": "^Z",
      "sucu": "^Z",
      "wdya": "^Z",
      "wdyn": "^Z",
      "severity": "Error",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": [],
      "clas": "^Z2UI5_C(L|X)",
      "intf": "^Z2UI5_IF",
      "prog": "^Z",
      "fugr": "^Z",
      "tabl": "^Z",
      "ttyp": "^Z",
      "dtel": "^Z",
      "doma": "^Z",
      "msag": "^Z",
      "tran": "^Z",
      "enqu": "^EZ",
      "auth": "^Z",
      "pinf": "^Z",
      "idoc": "^Z",
      "xslt": "^Z",
      "ssfo": "^Z",
      "ssst": "^Z",
      "shlp": "^Z"
    },
    "range_row_values": true,
    "redundant_cast": true,
    "smim_consistency": true,
    "sort_empty_key": true,
    // added 2026-11 with their findings fixed (abap2UI5 settings). Exceptions:
    // no_aliases excludes z2ui5_cl_tm_001: its ALIASES are public, callers in
    // other systems address the interface members by the alias names;
    // unused_methods excludes z2ui5_cl_tm_pop: set_row_id is a protected method of
    // a non-final class, a subclass elsewhere may call it; unused_variables also
    // skips mv_f4_fname, mv_shlpfield and mv_transport, protected attributes of
    // the non-final z2ui5_cl_tm_001 for the same reason; subrc_after_assign
    // excludes z2ui5_cl_tm_context, the vendored copy of abap-util (fixed there,
    // not here)
    "change_if_to_case": true,
    "if_in_if": true,
    "no_aliases": {
      "ignorePrivate": false,
      "exclude": [
        "/src/z2ui5_cl_tm_001"
      ]
    },
    "short_case": true,
    "subrc_after_assign": {
      "exclude": [
        "/src/z2ui5_cl_tm_context"
      ]
    },
    "unused_methods": {
      "exclude": [
        "/src/z2ui5_cl_tm_pop"
      ]
    },
    "unused_variables": {
      "skipAbstract": false,
      "severity": "Error",
      "skipNames": [
        "lv_dummy",
        "lv_dummy2",
        "lv_dummy3",
        "lv_dummy4",
        "<dummy>",
        "mv_f4_fname",
        "mv_shlpfield",
        "mv_transport"
      ]
    },
    "use_bool_expression": true,
    // added 2026-11 with its findings fixed: UNASSIGN before an ASSIGN in a loop.
    // The two in the vendored z2ui5_cl_tm_context were fixed in abap-util
    // (zabaputil_cl_util_context) and copied from there
    "is_assigned_in_loop": true,
    // added 2026-11: newer abaplint rules that report nothing here
    "abapdoc_short_link": true,
    "boolean_flag_via_if": true,
    "cast_via_generic_reference": true,
    // added 2026-11 on abaplint 2.120.116: every remaining rule of
    // `abaplint --default` is listed. Those that report nothing here, with
    // abap2UI5's settings (or the app rule set's, .github/abaplint/app-rules.json,
    // where abap2UI5 has none)
    "alias_never_reassigned": true,
    "align_pseudo_comments": true,
    "align_type_expressions": true,
    "bdef_check_syntax": true,
    "bdef_parser_error": true,
    "cds_check_syntax": true,
    "cds_naming": {
      "basicInterfaceView": "Z2UI5_",
      "compositeInterfaceView": "Z2UI5_",
      "consumptionView": "Z2UI5_",
      "basicRestrictedReuseView": "Z2UI5_",
      "compositeRestrictedReuseView": "Z2UI5_",
      "privateView": "Z2UI5_",
      "remoteAPIView": "Z2UI5_",
      "viewExtend": "Z2UI5_",
      "extensionIncludeView": "Z2UI5_",
      "derivationFunction": "Z2UI5_",
      "abstractEntity": "Z2UI5_"
    },
    "character_field_literal_blanks": true,
    "copy_chain": true,
    "field_symbol_never_assigned": true,
    // statements with a successor that this repository no longer uses -
    // listed so they do not come back (abaplint 2.120.116+). The
    // widely used READ TABLE / APPEND / CREATE OBJECT / ... follow
    // once the code no longer has them
    "forbidden_statement": {
      "statements": [
        "Describe",
        "Refresh",
        "Ranges",
        "SelectLoop",
        "Collect",
        "Overlay",
        "Leave",
        "TypePools",
        "Perform",
        "Form",
        "Write",
        "ReadTable",
        "Append",
        "CreateObject",
        "GetReference",
        "Concatenate",
        "Condense",
        "Translate",
        "Replace",
        "Find",
        "Shift",
        "Check"
      ],
      // MoveCorresponding stays allowed: z2ui5_cl_tm_001 moves between
      // generic rows (TYPE any), which CORRESPONDING #( ) cannot take
      // the vendored abap-util copies stay close to the master (AGENTS.md)
      "exclude": [
        "/src/z2ui5_cl_tm_context",
        "/src/z2ui5_cx_tm_error"
      ]
    },
    "function_module_parameter_names": true,
    "inline_generic_source": true,
    // 255: the longest line abapGit and the ABAP editor accept
    "line_length": {
      "maxIssuesPerFile": 10,
      "length": 255
    },
    "local_class_naming": {
      "ignoreNames": [],
      "ignorePatterns": [],
      "patternKind": "required",
      "local": "^LCL_.+$",
      "exception": "^LCX_.+$",
      "test": "^LTCL_.+$"
    },
    "loop_target_misuse": true,
    "no_macros": true,
    "prefer_raise_message": true,
    "selection_screen_texts_missing": true,
    "sequential_read_sorted": true,
    "sort_required": true,
    "space_before_colon": true,
    "space_before_dot": true,
    "stale_subrc": true,
    "start_at_tab": true,
    "suspicious_loop": true,
    "sy_read_restriction": true,
    "try_cast_empty_catch": true,
    "unit_test_assertions": true,
    "unnecessary_copy": true,
    // added 2026-11 with their findings fixed: end-of-line comments moved
    // above their statement, a double space, a lower-case keyword, ORDER BY
    // PRIMARY KEY on the table read (the rows are sorted right after anyway)
    "check_comments": true,
    "double_space": {
      "skipKeywords": ["CHANGING","EXPORTING","OTHERS"],
      "keywords": false,
      "startParen": true,
      "endParen": false,
      "afterColon": true
    },
    "keyword_case": {
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "ignoreFunctionModuleName": false,
      "ignoreGlobalClassBoundaries": false,
      "maxIssuesPerFile": 10,
      "style": "upper",
      "ignoreExceptions": true,
      "ignoreLowerClassImplmentationStatement": true,
      "ignoreKeywords": []
    },
    "no_yoda_conditions": {
      "onlyConstants": true
    },
    "select_add_order_by": true,
    // added 2026-11 with abap2UI5's settings and narrow exceptions:
    "check_subrc": {
      "openDataset": true,
      "authorityCheck": true,
      "selectSingle": true,
      "selectTable": true,
      "updateDatabase": true,
      "insertDatabase": true,
      "modifyDatabase": true,
      "deleteDatabase": true,
      "readTable": true,
      "assign": true,
      "find": true,
      "callFunction": true,
      "callMethod": true,
      // z2ui5_cl_tm_001 and z2ui5_cl_tm_pop read ASSIGN COMPONENT / READ TABLE
      // results and dynamic DB writes without sy-subrc by design at 15 sites;
      // each needs its own error-handling decision, not a mechanical fix.
      // z2ui5_cl_tm_context is the vendored abap-util copy (fixed there)
      "exclude": [
        "/src/z2ui5_cl_tm_001",
        "/src/z2ui5_cl_tm_pop",
        "/src/z2ui5_cl_tm_context"
      ]
    },
    "cyclomatic_complexity": {
      // button_save and on_after_popup: splitting them is a refactoring
      "exclude": [
        "/src/z2ui5_cl_tm_001"
      ],
      "max": 10
    },
    // table maintenance IS dynamic SQL on a table chosen at runtime - the one
    // part of abap2UI5's settings switched off here; every other dangerous
    // statement stays reported
    "dangerous_statement": {
      "editorCallForReport": true,
      "ignoreRAPQueryProvider": true,
      "insertTextpool": true,
      "execSQL": true,
      "kernelCall": true,
      "systemCall": true,
      "insertReport": true,
      "generateDynpro": true,
      "generateReport": true,
      "generateSubroutine": true,
      "deleteReport": true,
      "deleteTextpool": true,
      "deleteDynpro": true,
      "exportDynpro": true,
      "dynamicSQL": false
    },
    // the interface hands over the core's view builder node and a transport
    // type of the context class - its contract (AGENTS.md)
    "intf_referencing_clas": {
      "allow": [
        "^cl_abap_",
        "^z2ui5_cl_ui5_view_builder$",
        "^z2ui5_cl_tm_context$"
      ]
    },
    "method_length": {
      "checkFunctionModules": true,
      // button_save, on_after_popup (z2ui5_cl_tm_001) and the popup view
      // (z2ui5_cl_tm_pop): splitting them is a refactoring; the vendored
      // z2ui5_cl_tm_context stays close to the master
      "exclude": [
        "/src/z2ui5_cl_tm_001",
        "/src/z2ui5_cl_tm_pop",
        "/src/z2ui5_cl_tm_context"
      ],
      "statements": 50,
      "errorWhenEmpty": false,
      "ignoreTestClasses": true,
      "checkForms": true
    },
    // z2ui5_cl_tm_001 writes the table the user maintains - any table, which
    // is the point of the app
    "modify_only_own_db_tables": {
      "exclude": [
        "/src/z2ui5_cl_tm_001"
      ],
      "reportDynamic": true,
      "ownTables": "^[yz]"
    },
    "nesting": {
      // on_after_popup: flattening it is a refactoring
      "exclude": [
        "/src/z2ui5_cl_tm_001"
      ],
      "depth": 5
    },
    // the vendored abap-util copies stay close to the master (AGENTS.md)
    "no_exclamation_escape": {
      "exclude": [
        "/src/z2ui5_cl_tm_context",
        "/src/z2ui5_cx_tm_error"
      ]
    },
    "types_naming": {
      // the vendored abap-util copy stays close to the master (AGENTS.md)
      "exclude": [
        "/src/z2ui5_cl_tm_context"
      ],
      "pattern": "^TY_"
    },
    "unhandled_classic_exception": {
      // all findings sit in the vendored abap-util copy - fixed there, not here
      "exclude": [
        "/src/z2ui5_cl_tm_context"
      ],
      "missingOthers": true,
      "missingExceptions": true,
      "missingErrorMessage": true,
      "allowLiteralArguments": true
    },
    // kept off. Layout rules that would fight the view-builder chain layout
    // (.claude/skills/view-chain-layout in abap2UI5) or the house alignment -
    // off in abap2UI5 and in the app rule set as well
    "align_parameters": false,
    "empty_line_in_statement": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "in_statement_indentation": false,
    "indentation": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "keep_single_parameter_on_one_line": false,
    "line_break_multiple_parameters": false,
    "line_only_punc": false,
    // inlining a temporary into its single use would pull whole builder chains
    // (toolbar, header) into a parameter list
    "single_use_expression_temp": false,
    // naming conventions this repository does not follow (no Hungarian
    // prefixes required) - off in abap2UI5 and in the app rule set
    "class_attribute_names": false,
    "local_variable_names": false,
    "method_parameter_names": false,
    "no_prefixes": false,
    // style preferences abap2UI5 and the app rule set both keep off
    "abapdoc": false,
    "generic_regex": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "no_inline_in_optional_branches": false,
    "prefer_corresponding": false,
    "prefer_inline": false,
    "prefer_inline_cast": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    "prefer_insert_into_table": false,
    "prefer_string_template": true, // 0 findings here - on, so none come back (off in the abap2UI5 core)
    // off as in abap2UI5's abaplint.jsonc: the commented MESSAGE statements
    // in z2ui5_cl_tm_pop / z2ui5_cl_tm_001 name the T100 message a text comes
    // from (where-used), and the vendored z2ui5_cl_tm_context keeps the
    // master's commented blocks
    "commented_code": false,
    // the embedding contract is public attributes (z2ui5_if_tm_001) - off in
    // abap2UI5 and the app rule set
    "no_public_attributes": false,
    // a table maintenance for any table is dynamic by nature
    // (ASSIGN COMPONENT, CREATE DATA TYPE HANDLE, SELECT FROM (name))
    "no_dynamic_stuff": false
  }
}
